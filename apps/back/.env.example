# Serveur
PORT=4000
NODE_ENV=development

# MongoDB Atlas — remplacer par la vraie connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/reagis

# JWT — deux secrets distincts (durées fixées dans le code : présentateur 1d, participant 6h)
JWT_SECRET=change-me-in-production
PARTICIPANT_JWT_SECRET=change-me-too-different-secret

# CORS — URL du client web en dev
CLIENT_URL=http://localhost:5173
